APP_ENV=local
# Local (outside Docker): use localhost. Docker Compose overrides this to host `db`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/post_discharge_follow_up
DRY_RUN_DEFAULT=true
# How often the background scheduler looks for due follow-ups and places calls.
SCHEDULER_INTERVAL_MINUTES=1

# JWT auth (required). Use a long random secret in production.
JWT_SECRET=change-me-to-a-long-random-secret-32b+
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# Developer API key from https://dashboard.heycall-e.com/account/api-keys
# Required for scripts/hello_world_call.py (Python server SDK path).
CALLE_API_KEY=calle_live_key

# Optional; default is production.
CALLE_BASE_URL=https://api.heycall-e.com

# Your real E.164 phone number for the hello-world call (e.g. +9198XXXXXXXX).
CALLE_EXAMPLE_PHONE=+15555550100

# Optional; used later when verifying webhook signatures.
# CALLE_WEBHOOK_SECRET=whsec_...

# Public HTTPS URL CALL-E will POST terminal call events to.
# Local: ngrok http 8000 → https://xxxx.ngrok-free.app/webhooks/calle
# CALLE_WEBHOOK_URL=https://xxxx.ngrok-free.app/webhooks/calle

# Claude / Anthropic for transcript fact extraction (ai_analysis.py)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_ENABLED=true

# Embeddings run locally with sentence-transformers/all-MiniLM-L6-v2.
# No embedding API key is required.

# Google Gemini for the admin agent (tool calling)
GOOGLE_API_KEY=
AGENT_MODEL=gemini-flash-latest
AGENT_ENABLED=true
